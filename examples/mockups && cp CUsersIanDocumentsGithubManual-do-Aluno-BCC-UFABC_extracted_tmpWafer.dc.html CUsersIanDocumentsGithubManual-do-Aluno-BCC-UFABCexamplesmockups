<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Menu lateral do manual</title>
<script src="./_runtime/react.js"></script>
<script src="./_runtime/react-dom.js"></script>
<script src="./_runtime/support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap" rel="stylesheet">
<style>
body{margin:0}
</style>
</helmet>
<nav aria-label="Seções do manual" style="width: 260px; padding: 40px 0; font-family: Inter, system-ui, sans-serif; font-size: 14px; line-height: 1.5; color: #0E1726; box-sizing: border-box">
<sc-for list="{{nav}}" as="sec" hint-placeholder-count="3">
<div style="margin-bottom: 28px">
<p style="margin: 0 0 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{sec.c}}">{{sec.label}}</p>
<ul style="list-style: none; margin: 0; padding: 0; border-left: 2px solid #E2E6EA">
<sc-for list="{{sec.items}}" as="it" hint-placeholder-count="6">
<li><a href="{{it.href}}" style="display: block; padding: 6px 14px; margin-left: -2px; text-decoration: none; color: {{it.color}}; font-weight: {{it.w}}; border-left: 2px solid {{it.b}}; background: {{it.bg}}">{{it.t}}</a></li>
</sc-for>
</ul>
</div>
</sc-for>
</nav>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"atual":{"editor":"text","default":"Campi e cursos"},"$preview":{"width":260,"height":1060}}'>
class Component extends DCLogic {
  renderVals() {
    const on = this.props.atual ?? 'Campi e cursos';
    const mk = (arr) => arr.map(([t, href]) => t === on
      ? { t, href, color: '#0E1726', w: 600, b: '#008BBB', bg: '#E6F4F9' }
      : { t, href, color: '#4A5568', w: 400, b: 'transparent', bg: 'transparent' });
    return {
      nav: [
        { label: 'Parte 1 · UFABC', c: '#006633', items: mk([['Campi e cursos', 'Campi.dc.html'], ['Matrícula e ajustes', 'Matricula.dc.html'], ['Avaliação e coeficientes', 'Pagina.dc.html'], ['Projetos e oportunidades', 'Projetos.dc.html']]) },
        { label: 'Parte 2 · BC&T', c: '#0E1726', items: mk([['O que é o BC&T', '#'], ['Matriz curricular', 'MatrizBCT.dc.html'], ['Quadrimestre ideal', '#'], ['Reprovações', '#'], ['Conclusão e curso específico', '#']]) },
        { label: 'Parte 3 · BCC', c: '#006E95', items: mk([['O que é o BCC', '#'], ['Grade curricular', 'Grade.dc.html'], ['Diferenças entre os PPCs', 'PPC.dc.html'], ['Estágio', '#'], ['PGC / TCC', '#'], ['Conclusão do curso', '#']]) }
      ]
    };
  }
}
</script>
</body>
</html>
