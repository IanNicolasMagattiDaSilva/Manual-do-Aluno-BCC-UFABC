<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>PDF — Grade curricular (paisagem)</title>
<script src="./_runtime/react.js"></script>
<script src="./_runtime/react-dom.js"></script>
<script src="./_runtime/support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link href="https://fonts.googleapis.com/css2?family=Anton&amp;family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap" rel="stylesheet">
<style>
body{margin:0;background:#FFFFFF}
</style>
</helmet>
<div style="width: 1123px; height: 794px; position: relative; overflow: hidden; background: #FFFFFF; color: #0E1726; font-family: Inter, system-ui, sans-serif; font-size: 13px; line-height: 1.4">
<div style="position: absolute; left: 56px; right: 56px; top: 40px; display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid #CBD2D9; font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #4A5568">
<span>Manual do aluno</span>
<span style="display: flex; align-items: center; gap: 8px"><span style="width: 8px; height: 8px; background: #008BBB"></span>Parte 3 · BCC</span>
</div>

<div style="position: absolute; left: 56px; right: 56px; top: 84px; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px">
<div>
<h1 style="margin: 0; font-family: Anton, sans-serif; font-weight: 400; font-size: 40px; line-height: 1; text-transform: uppercase">Grade curricular sugerida · PPC 2023</h1>
<p style="margin: 6px 0 0; color: #2D3748">15 quadrimestres (5 anos) recomendados · prazo máximo de 10 anos</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; max-width: 380px; font-size: 12px">
<sc-for list="{{legend}}" as="l" hint-placeholder-count="5">
<span style="display: inline-flex; align-items: center; gap: 6px"><span style="width: 12px; height: 12px; background: {{l.c}}; border: 1px solid {{l.bd}}; box-sizing: border-box"></span>{{l.t}}</span>
</sc-for>
</div>
</div>

<div style="position: absolute; left: 56px; right: 56px; top: 170px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px">
<sc-for list="{{anos}}" as="ano" hint-placeholder-count="5">
<div style="display: flex; flex-direction: column; gap: 8px">
<p style="margin: 0; font-family: Anton, sans-serif; font-size: 18px; text-transform: uppercase; border-bottom: 2px solid #0E1726; padding-bottom: 2px">{{ano.t}}</p>
<sc-for list="{{ano.quads}}" as="q" hint-placeholder-count="3">
<div style="background: #F5F7F9; padding: 8px; display: flex; flex-direction: column; gap: 4px; height: 160px; box-sizing: border-box">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700">{{q.t}}</span>
<sc-for list="{{q.cards}}" as="c" hint-placeholder-count="5">
<span style="display: block; background: {{c.bg}}; border-top: 3px solid {{c.strip}}; padding: 3px 6px; font-size: 11px; color: {{c.fg}}; font-weight: {{c.w}}; white-space: nowrap; overflow: hidden">{{c.nome}}</span>
</sc-for>
</div>
</sc-for>
</div>
</sc-for>
</div>

<div style="position: absolute; left: 56px; bottom: 32px">
<dc-import name="PdfFolio" secao="Parte 3 · BCC" num="15" w="{{ 1011 }}" hint-size="1011px,36px"></dc-import>
</div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"$preview":{"width":1123,"height":794}}'>
class Component extends DCLogic {
  renderVals() {
    const strip = { bct: '#0E1726', bcc: '#008BBB', ol: '#006633', liv: '#B8C2CC' };
    const mix = (q) => q <= 3 ? ['bct', 'bct', 'bct', 'bct', 'liv']
      : q <= 6 ? ['bct', 'bct', 'bct', 'bcc', 'liv']
      : q <= 9 ? ['bct', 'bcc', 'bcc', 'ol', 'liv']
      : q <= 12 ? ['bcc', 'bcc', 'bcc', 'ol', 'liv']
      : ['bcc', 'bcc', 'ol', 'ol', 'liv'];
    const anos = [];
    for (let a = 0; a < 5; a++) {
      const quads = [];
      for (let i = 1; i <= 3; i++) {
        const q = a * 3 + i;
        let cards = mix(q).map((k) => ({ nome: '[Disciplina]', bg: '#FFFFFF', strip: strip[k], fg: '#4A5568', w: 400 }));
        if (q === 15) cards = [{ nome: 'TCC · 12 cr', bg: '#FFCC00', strip: '#0E1726', fg: '#0E1726', w: 700 }, ...cards.slice(0, 4)];
        quads.push({ t: q + 'º quad.', cards });
      }
      anos.push({ t: (a + 1) + 'º ano', quads });
    }
    return {
      anos,
      legend: [
        { t: 'Obrigatória BC&T', c: '#0E1726', bd: '#0E1726' },
        { t: 'Obrigatória BCC', c: '#008BBB', bd: '#008BBB' },
        { t: 'Opção limitada', c: '#006633', bd: '#006633' },
        { t: 'Livre', c: '#B8C2CC', bd: '#B8C2CC' },
        { t: 'TCC', c: '#FFCC00', bd: '#0E1726' }
      ]
    };
  }
}
</script>
</body>
</html>
