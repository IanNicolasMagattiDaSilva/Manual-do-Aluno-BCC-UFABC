<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Manual do BCC — Projetos e oportunidades</title>
<script src="./_runtime/react.js"></script>
<script src="./_runtime/react-dom.js"></script>
<script src="./_runtime/support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link href="https://fonts.googleapis.com/css2?family=Anton&amp;family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap" rel="stylesheet">
<style>
body{margin:0;background:#FFFFFF}
a{color:#006E95}a:hover{color:#004F6B}
</style>
</helmet>
<div style="width: 100%; min-height: 100vh; background: #FFFFFF; color: #0E1726; font-family: Inter, system-ui, sans-serif; font-size: 16px; line-height: 1.7">
<dc-import name="Header" ativo="ufabc" hint-size="100%,77px"></dc-import>
<div style="max-width: 1360px; margin: 0 auto; padding: 0 32px; display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; box-sizing: border-box">
<div style="flex: 0 1 260px"><dc-import name="Sidebar" atual="Projetos e oportunidades" hint-size="260px,1060px"></dc-import></div>
<main style="flex: 999 1 560px; min-width: 0; padding: 40px 0 96px; max-width: 920px">
<p style="margin: 0 0 24px; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #4A5568"><a href="Main.dc.html" style="color: #4A5568">Início</a> / UFABC / <span style="color: #0E1726">Projetos e oportunidades</span></p>
<dc-import name="Hero" parte="Parte 1 · UFABC" titulo="Projetos e oportunidades" tema="{{ tema }}" seed="{{ 66 }}" hint-size="100%,220px"></dc-import>

<nav aria-label="Nesta página" style="display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 0">
<a href="#extensao" style="padding: 8px 14px; border: 2px solid #0E1726; text-decoration: none; color: #0E1726; font-weight: 600; font-size: 14px">Extensão e cultura</a>
<a href="#monitoria" style="padding: 8px 14px; border: 2px solid #0E1726; text-decoration: none; color: #0E1726; font-weight: 600; font-size: 14px">Monitoria</a>
<a href="#entidades" style="padding: 8px 14px; border: 2px solid #0E1726; text-decoration: none; color: #0E1726; font-weight: 600; font-size: 14px">Entidades</a>
<a href="#pesquisa" style="padding: 8px 14px; border: 2px solid #0E1726; text-decoration: none; color: #0E1726; font-weight: 600; font-size: 14px">Pesquisa</a>
</nav>

<h2 id="extensao" style="margin: 56px 0 8px; font-family: Anton, sans-serif; font-weight: 400; font-size: 34px; text-transform: uppercase">Extensão e cultura</h2>
<p style="margin: 0 0 20px; color: #2D3748; max-width: 720px">Projetos, eventos, cursos e outras ações que aproximam a universidade da sociedade. Todo ano a PROEC abre seleção para bolsistas e voluntários.</p>
<ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0; border: 2px solid #0E1726">
<sc-for list="{{fluxo}}" as="f" hint-placeholder-count="3">
<li style="padding: 20px; border-right: 1px solid #E2E6EA; display: flex; flex-direction: column; gap: 6px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; color: #006633">{{f.n}}</span>
<span style="font-weight: 700">{{f.t}}</span>
<span style="font-size: 14px; color: #4A5568; line-height: 1.5">{{f.d}}</span>
</li>
</sc-for>
</ol>
<div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; align-items: center">
<span style="font-size: 14px; color: #4A5568; margin-right: 4px">Exemplos de projetos:</span>
<span style="padding: 4px 10px; background: #F1F3F5; font-size: 14px">TecMinas UFABC</span>
<span style="padding: 4px 10px; background: #F1F3F5; font-size: 14px">Coletivo Min@s</span>
<span style="padding: 4px 10px; background: #F1F3F5; font-size: 14px">Diversão Séria</span>
</div>
<aside style="margin-top: 20px; background: #FFCC00; padding: 20px 24px; display: flex; gap: 16px; align-items: baseline; flex-wrap: wrap">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase">// Dica</span>
<p style="margin: 0; flex: 1 1 400px; font-weight: 500">Fora do período de seleção, dá para entrar como voluntário falando direto com o professor coordenador do projeto.</p>
</aside>

<h2 id="monitoria" style="margin: 56px 0 8px; font-family: Anton, sans-serif; font-weight: 400; font-size: 34px; text-transform: uppercase">Monitoria</h2>
<p style="margin: 0 0 20px; color: #2D3748; max-width: 720px">Editais saem a cada quadrimestre. Não gera vínculo empregatício: é uma oportunidade de desenvolvimento dentro da graduação.</p>
<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px">
<div style="background: #0E1726; color: #FFFFFF; padding: 24px; display: flex; flex-direction: column; gap: 10px">
<span style="font-family: Anton, sans-serif; font-size: 28px; text-transform: uppercase">Bolsista</span>
<span style="font-family: Anton, sans-serif; font-size: 48px; line-height: 1; color: #FFCC00">12 h</span>
<span style="font-size: 14px; color: #D5DCE3">por semana dedicadas ao projeto</span>
<span style="border-top: 1px solid #33404F; padding-top: 10px; font-weight: 600">Recebe auxílio mensal</span>
</div>
<div style="border: 2px solid #0E1726; padding: 24px; display: flex; flex-direction: column; gap: 10px">
<span style="font-family: Anton, sans-serif; font-size: 28px; text-transform: uppercase">Voluntário</span>
<span style="font-family: Anton, sans-serif; font-size: 48px; line-height: 1; color: #006E95">Certificado</span>
<span style="font-size: 14px; color: #4A5568">ao final das atividades</span>
<span style="border-top: 1px solid #E2E6EA; padding-top: 10px; font-weight: 600">Sem remuneração</span>
</div>
</div>

<h2 id="entidades" style="margin: 56px 0 8px; font-family: Anton, sans-serif; font-weight: 400; font-size: 34px; text-transform: uppercase">Entidades estudantis</h2>
<p style="margin: 0 0 20px; color: #2D3748; max-width: 720px">Organizações criadas e geridas por estudantes, com objetivos acadêmicos, profissionais ou empreendedores. As horas dedicadas podem contar como extensão, dependendo da atividade.</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px">
<sc-for list="{{entidades}}" as="e" hint-placeholder-count="3">
<article style="border-top: 6px solid {{e.c}}; background: #F5F7F9; padding: 22px; display: flex; flex-direction: column; gap: 8px">
<span style="font-family: Anton, sans-serif; font-size: 24px; text-transform: uppercase; line-height: 1.1">{{e.t}}</span>
<span style="font-size: 14px; color: #2D3748; line-height: 1.55">{{e.d}}</span>
</article>
</sc-for>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; align-items: center">
<span style="font-size: 14px; color: #4A5568; margin-right: 4px">Na computação:</span>
<span style="padding: 4px 10px; background: #E6F4F9; font-size: 14px; font-weight: 600">GRUB · programação competitiva</span>
<span style="padding: 4px 10px; background: #E6F4F9; font-size: 14px; font-weight: 600">Green Team Hacker Club</span>
<span style="padding: 4px 10px; background: #E6F4F9; font-size: 14px; font-weight: 600">Robótica</span>
<span style="padding: 4px 10px; background: #E6F4F9; font-size: 14px; font-weight: 600">EducaMina</span>
</div>

<h2 id="pesquisa" style="margin: 56px 0 8px; font-family: Anton, sans-serif; font-weight: 400; font-size: 34px; text-transform: uppercase">Pesquisa (iniciação científica)</h2>
<p style="margin: 0 0 20px; color: #2D3748; max-width: 720px">Na UFABC, ensino e pesquisa andam juntos. Há programas com bolsa e com participação voluntária.</p>
<div style="overflow-x: auto">
<table style="width: 100%; min-width: 560px; border-collapse: collapse; font-size: 15px">
<thead>
<tr style="background: #0E1726; color: #FFFFFF; text-align: left">
<th scope="col" style="padding: 12px 16px; font-weight: 600">Programa</th>
<th scope="col" style="padding: 12px 16px; font-weight: 600">Para quem</th>
<th scope="col" style="padding: 12px 16px; font-weight: 600">Financiamento</th>
</tr>
</thead>
<tbody>
<sc-for list="{{pesquisa}}" as="p" hint-placeholder-count="3">
<tr style="border-bottom: 1px solid #E2E6EA; vertical-align: top">
<th scope="row" style="padding: 14px 16px; text-align: left"><span style="font-family: Anton, sans-serif; font-size: 22px; font-weight: 400">{{p.sigla}}</span><br><span style="font-size: 13px; font-weight: 400; color: #4A5568">{{p.nome}}</span></th>
<td style="padding: 14px 16px; color: #2D3748">{{p.quem}}</td>
<td style="padding: 14px 16px; color: #2D3748">{{p.fin}}</td>
</tr>
</sc-for>
</tbody>
</table>
</div>
<p style="margin: 16px 0 0; font-size: 14px; color: #4A5568">Para apresentar trabalhos em congressos e simpósios, existe ainda a Bolsa Auxílio Eventos.</p>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 64px">
<a href="Pagina.dc.html" style="border: 2px solid #E2E6EA; padding: 20px; text-decoration: none; color: #0E1726; display: flex; flex-direction: column; gap: 4px"><span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #4A5568">← Anterior</span><span style="font-weight: 600; font-size: 17px">Avaliação e coeficientes</span></a>
<a href="MatrizBCT.dc.html" style="border: 2px solid #008BBB; padding: 20px; text-decoration: none; color: #0E1726; display: flex; flex-direction: column; gap: 4px; text-align: right"><span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #006E95">Próxima →</span><span style="font-weight: 600; font-size: 17px">Parte 2 · BC&amp;T</span></a>
</div>
</main>
</div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"tema":{"editor":"enum","options":["amarelo","azul"],"default":"amarelo"},"$preview":{"width":1440,"height":2900}}'>
class Component extends DCLogic {
  renderVals() {
    return {
      tema: this.props.tema ?? 'amarelo',
      fluxo: [
        { n: '01', t: 'Seleção da PROEC', d: 'Processo seletivo anual, obrigatório para quem quer bolsa.' },
        { n: '02', t: 'Edital e termo de outorga', d: 'Formalizam a sua participação no projeto.' },
        { n: '03', t: 'Certificado', d: 'Emitido no fim do projeto; comprova horas de extensão.' }
      ],
      entidades: [
        { t: 'Empresa Júnior', d: 'Projetos e serviços da área do curso, funcionando como uma empresa, mas com fins educacionais.', c: '#006633' },
        { t: 'Liga de competição', d: 'Equipes para competições acadêmicas e tecnológicas: robótica, foguetes, programação, automobilismo.', c: '#008BBB' },
        { t: 'Liga acadêmica', d: 'Cursos, palestras, eventos e atividades de aprofundamento acadêmico e profissional.', c: '#FFCC00' }
      ],
      pesquisa: [
        { sigla: 'PDPD', nome: 'Pesquisando Desde o Primeiro Dia', quem: 'Alunos do primeiro ano', fin: 'Bolsas da UFABC' },
        { sigla: 'PIC', nome: 'Programa de Iniciação Científica', quem: 'Estudantes de graduação', fin: 'Bolsas da UFABC ou participação voluntária' },
        { sigla: 'PIBIC', nome: 'Programa Institucional de Bolsas de IC', quem: 'Estudantes de graduação', fin: 'Bolsas do CNPq' }
      ]
    };
  }
}
</script>
</body>
</html>
