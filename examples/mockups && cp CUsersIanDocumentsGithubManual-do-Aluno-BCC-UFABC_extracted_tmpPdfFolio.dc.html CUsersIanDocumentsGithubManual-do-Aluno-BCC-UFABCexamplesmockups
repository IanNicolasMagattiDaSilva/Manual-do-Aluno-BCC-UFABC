<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Manual do BCC — Avaliação e coeficientes</title>
<script src="./_runtime/react.js"></script>
<script src="./_runtime/react-dom.js"></script>
<script src="./_runtime/support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&amp;family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap" rel="stylesheet">
<style>
body{margin:0;background:#FFFFFF}
a{color:#006E95}a:hover{color:#004F6B}
</style>
</helmet>
<div style="width: 100%; min-height: 100vh; background: #FFFFFF; color: #0E1726; font-family: Inter, system-ui, sans-serif; font-size: 16px; line-height: 1.7">

<header style="border-bottom: 1px solid #E2E6EA; background: #FFFFFF">
<div style="max-width: 1360px; margin: 0 auto; padding: 14px 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 24px">
<a href="Main.dc.html" style="display: flex; align-items: center; gap: 14px; text-decoration: none; color: #0E1726">
<dc-import name="Logo" cell="{{ logoCell }}" color="#008BBB" hint-size="47px,20px"></dc-import>
<span style="font-family: Anton, sans-serif; font-size: 18px; letter-spacing: 0.5px; text-transform: uppercase; border-left: 1px solid #CBD2D9; padding-left: 14px">Manual do aluno</span>
</a>
<nav aria-label="Principal" style="display: flex; flex-wrap: wrap; gap: 4px; flex: 1 1 auto">
<a href="Main.dc.html" style="padding: 10px 14px; text-decoration: none; color: #4A5568; font-weight: 500; font-size: 15px">Início</a>
<a href="#" style="padding: 10px 14px; text-decoration: none; color: #0E1726; font-weight: 600; font-size: 15px; border-bottom: 3px solid #008BBB">UFABC</a>
<a href="#" style="padding: 10px 14px; text-decoration: none; color: #4A5568; font-weight: 500; font-size: 15px">BC&amp;T</a>
<a href="#" style="padding: 10px 14px; text-decoration: none; color: #4A5568; font-weight: 500; font-size: 15px">BCC</a>
</nav>
<label style="display: flex; align-items: center; gap: 8px; border: 1px solid #CBD2D9; padding: 0 12px; height: 44px; min-width: 220px; box-sizing: border-box; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #4A5568">
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4A5568" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
<span style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0)">Buscar no manual</span>
<input type="search" placeholder="Buscar no manual" style="border: 0; outline: 0; font: inherit; color: #0E1726; background: transparent; width: 100%">
</label>
<a href="#" style="display: flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; background: #008BBB; color: #FFFFFF; text-decoration: none; font-weight: 700; font-size: 14px">Baixar PDF</a>
</div>
</header>

<div style="max-width: 1360px; margin: 0 auto; padding: 0 32px; display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; box-sizing: border-box">

<nav aria-label="Seções do manual" style="flex: 1 1 240px; max-width: 280px; padding: 40px 0; font-size: 14px">
<sc-for list="{{nav}}" as="sec" hint-placeholder-count="3">
<div style="margin-bottom: 28px">
<p style="margin: 0 0 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{sec.c}}">{{sec.label}}</p>
<ul style="list-style: none; margin: 0; padding: 0; border-left: 2px solid #E2E6EA">
<sc-for list="{{sec.items}}" as="it" hint-placeholder-count="5">
<li><a href="#" style="display: block; padding: 6px 14px; margin-left: -2px; text-decoration: none; color: {{it.color}}; font-weight: {{it.w}}; border-left: 2px solid {{it.b}}; background: {{it.bg}}">{{it.t}}</a></li>
</sc-for>
</ul>
</div>
</sc-for>
</nav>

<main style="flex: 999 1 560px; min-width: 0; padding: 40px 0 96px; max-width: 760px">
<p style="margin: 0 0 24px; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #4A5568"><a href="Main.dc.html" style="color: #4A5568">Início</a> / <a href="#" style="color: #4A5568">UFABC</a> / <span style="color: #0E1726">Avaliação e coeficientes</span></p>

<div style="background: {{t.bg}}; padding: 36px 36px 32px; margin-bottom: 40px; position: relative; overflow: hidden">
<div aria-hidden="true" style="position: absolute; right: 0; top: 0; width: 460px; height: 280px">
<dc-import name="Wafer" tema="{{ tema }}" w="{{ 460 }}" h="{{ 280 }}" die="{{ 76 }}" ax="{{ 1 }}" ay="{{ 0.3 }}" seed="{{ 11 }}" fundo="{{ false }}" hint-size="460px,280px"></dc-import>
</div>
<p style="position: relative; margin: 0 0 8px; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: {{t.text}}">Parte 1 · UFABC</p>
<h1 style="position: relative; margin: 0; font-family: Anton, sans-serif; font-weight: 400; font-size: 64px; line-height: 1; text-transform: uppercase; max-width: 480px; color: {{t.title}}">Avaliação e coeficientes</h1>
</div>

<p style="margin: 0 0 32px; font-size: 19px; color: #2D3748">O desempenho do aluno em cada disciplina é expresso por <strong>conceitos</strong>, e não por notas numéricas. Isso permite uma leitura ao mesmo tempo qualitativa e quantitativa do aproveitamento.</p>

<h2 id="conceitos" style="margin: 48px 0 16px; font-family: Anton, sans-serif; font-weight: 400; font-size: 34px; text-transform: uppercase; letter-spacing: 0.3px">Conceitos</h2>
<div role="table" aria-label="Conceitos possíveis" style="border: 2px solid #0E1726">
<sc-for list="{{grades}}" as="g" hint-placeholder-count="7">
<div role="row" style="display: flex; align-items: center; gap: 20px; padding: 12px 16px; border-bottom: 1px solid #E2E6EA">
<span role="cell" style="width: 44px; height: 44px; flex: 0 0 44px; display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 20px; background: {{g.bg}}; color: {{g.fg}}">{{g.k}}</span>
<span role="cell" style="flex: 0 0 120px; font-weight: 600">{{g.status}}</span>
<span role="cell" style="color: #4A5568; font-size: 15px">{{g.d}}</span>
</div>
</sc-for>
</div>

<div style="margin: 32px 0; border: 2px solid #008BBB; background: #E6F4F9; padding: 20px 24px; display: flex; gap: 16px; align-items: flex-start">
<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#006E95" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex: 0 0 24px; margin-top: 3px"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5"></path><path d="M12 8h.01"></path></svg>
<div>
<p style="margin: 0 0 4px; font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px; letter-spacing: 3px; text-transform: uppercase; color: #006E95">Importante</p>
<p style="margin: 0">Se não obtiver conceito satisfatório, você tem direito a uma <strong>avaliação de recuperação</strong>, realizada no mínimo 72 horas após tomar conhecimento do conceito.</p>
</div>
</div>

<h2 id="coeficientes" style="margin: 48px 0 16px; font-family: Anton, sans-serif; font-weight: 400; font-size: 34px; text-transform: uppercase; letter-spacing: 0.3px">Coeficientes de desempenho</h2>
<p style="margin: 0 0 20px; color: #2D3748">Cada conceito recebe um peso no cálculo:</p>
<div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; font-family: 'JetBrains Mono', monospace; font-size: 14px">
<span style="background: #0E1726; color: #FFFFFF; padding: 6px 12px">A = 4</span>
<span style="background: #0E1726; color: #FFFFFF; padding: 6px 12px">B = 3</span>
<span style="background: #0E1726; color: #FFFFFF; padding: 6px 12px">C = 2</span>
<span style="background: #0E1726; color: #FFFFFF; padding: 6px 12px">D = 1</span>
<span style="background: #0E1726; color: #FFFFFF; padding: 6px 12px">F = O = 0</span>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px">
<sc-for list="{{coefs}}" as="c" hint-placeholder-count="3">
<article style="border: 2px solid #0E1726; border-top: 8px solid {{c.c}}; padding: 20px; display: flex; flex-direction: column; gap: 8px">
<span style="font-family: Anton, sans-serif; font-size: 48px; line-height: 1">{{c.k}}</span>
<span style="font-weight: 600">{{c.name}}</span>
<span style="font-size: 14px; color: #4A5568; line-height: 1.55">{{c.d}}</span>
</article>
</sc-for>
</div>

<h2 id="boas-praticas" style="margin: 48px 0 16px; font-family: Anton, sans-serif; font-weight: 400; font-size: 34px; text-transform: uppercase; letter-spacing: 0.3px">Boas práticas</h2>
<aside style="background: #FFCC00; padding: 28px 32px">
<p style="margin: 0 0 12px; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase">// Dica</p>
<ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 16px">
<li><strong>Planeje a carga de cada quadrimestre.</strong> Evitar sobrecarga reduz o risco de conceitos baixos que pesam no CR.</li>
<li><strong>Use a possibilidade de refazer disciplinas.</strong> No CA, só o melhor resultado conta.</li>
<li><strong>Trate o conceito D com atenção.</strong> Ele aprova, mas entra no CR com peso baixo.</li>
<li><strong>Leia o plano de ensino no primeiro dia</strong> para conhecer instrumentos e critérios.</li>
</ul>
</aside>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 64px">
<a href="#" style="border: 2px solid #E2E6EA; padding: 20px; text-decoration: none; color: #0E1726; display: flex; flex-direction: column; gap: 4px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #4A5568">← Anterior</span>
<span style="font-weight: 600; font-size: 17px">Segundo ajuste de matrícula</span>
</a>
<a href="#" style="border: 2px solid #008BBB; padding: 20px; text-decoration: none; color: #0E1726; display: flex; flex-direction: column; gap: 4px; text-align: right">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #006E95">Próxima →</span>
<span style="font-weight: 600; font-size: 17px">Trancamento de matrícula</span>
</a>
</div>
</main>

<aside aria-label="Nesta página" style="flex: 1 1 200px; max-width: 220px; padding: 40px 0; font-size: 14px">
<p style="margin: 0 0 12px; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #4A5568">Nesta página</p>
<ul style="list-style: none; margin: 0 0 32px; padding: 0; display: flex; flex-direction: column; gap: 8px">
<li><a href="#conceitos" style="color: #006E95; text-decoration: none; font-weight: 600">Conceitos</a></li>
<li><a href="#coeficientes" style="color: #4A5568; text-decoration: none">Coeficientes de desempenho</a></li>
<li><a href="#boas-praticas" style="color: #4A5568; text-decoration: none">Boas práticas</a></li>
</ul>
<a href="#" style="display: flex; align-items: center; gap: 8px; color: #4A5568; text-decoration: none; font-size: 13px">
<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4A5568" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
Baixar esta seção em PDF</a>
</aside>

</div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"tema":{"editor":"enum","options":["amarelo","azul"],"default":"amarelo"},"$preview":{"width":1440,"height":1900}}'>
class Component extends DCLogic {
  theme() {
    return (this.props.tema ?? 'amarelo') === 'azul'
      ? { bg: '#008BBB', title: '#FFFFFF', text: '#04222F', }
      : { bg: '#FFCC00', title: '#0E1726', text: '#0E1726', };
  }
  renderVals() {
    const t = this.theme();
    const mk = (arr, on) => arr.map((x) => x === on
      ? { t: x, color: '#0E1726', w: 600, b: '#008BBB', bg: '#E6F4F9' }
      : { t: x, color: '#4A5568', w: 400, b: 'transparent', bg: 'transparent' });
    return {
      t,
      tema: this.props.tema ?? 'amarelo',
      logoCell: 3,
      nav: [
        { label: 'Parte 1 · UFABC', c: '#006633', items: mk(['Campi e cursos', 'Sistema quadrimestral', 'Matrícula', 'Primeiro ajuste', 'Cancelamento de disciplinas', 'Segundo ajuste', 'Avaliação e coeficientes', 'Trancamento de matrícula', 'Projetos'], 'Avaliação e coeficientes') },
        { label: 'Parte 2 · BC&T', c: '#0E1726', items: mk(['O que é o BC&T', 'Plano pedagógico', 'Matriz curricular', 'Quadrimestre ideal', 'Reprovações', 'Conclusão de curso'], '') },
        { label: 'Parte 3 · BCC', c: '#006E95', items: mk(['O que é o BCC', 'Matriz curricular', 'Estágio', 'PGC / TCC', 'Conclusão do curso'], '') }
      ],
      grades: [
        { k: 'A', status: 'Aprovado', d: 'Desempenho excepcional', bg: '#006633', fg: '#FFFFFF' },
        { k: 'B', status: 'Aprovado', d: 'Bom desempenho', bg: '#006633', fg: '#FFFFFF' },
        { k: 'C', status: 'Aprovado', d: 'Desempenho mínimo satisfatório', bg: '#006633', fg: '#FFFFFF' },
        { k: 'D', status: 'Aprovado', d: 'Aproveitamento mínimo não satisfatório', bg: '#FFCC00', fg: '#0E1726' },
        { k: 'F', status: 'Reprovado', d: 'A disciplina deve ser cursada novamente', bg: '#B3261E', fg: '#FFFFFF' },
        { k: 'O', status: 'Reprovado', d: 'Reprovado por falta', bg: '#B3261E', fg: '#FFFFFF' },
        { k: 'I', status: 'Incompleto', d: 'Convertido em A, B, C, D ou F até o fim do quadrimestre seguinte', bg: '#E2E6EA', fg: '#0E1726' }
      ],
      coefs: [
        { k: 'CR', name: 'Coeficiente de Rendimento', d: 'Média dos conceitos ponderada pelos créditos, considerando todas as disciplinas cursadas.', c: '#008BBB' },
        { k: 'CA', name: 'Coeficiente de Aproveitamento', d: 'Como o CR, mas em disciplinas repetidas conta só o melhor conceito.', c: '#006633' },
        { k: 'CP', name: 'Coeficiente de Progressão', d: 'Compara os créditos já aprovados com os créditos exigidos pelo curso.', c: '#FFCC00' }
      ]
    };
  }
}
</script>
</body>
</html>
